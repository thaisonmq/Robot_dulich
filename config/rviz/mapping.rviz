Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 238; 241; 246
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/Map
      Name: Live SLAM Map
      Enabled: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.9
    - Class: rviz_default_plugins/LaserScan
      Name: Mapping LiDAR
      Enabled: true
      Topic:
        Value: /scan_mapping
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 239; 68; 68
    - Class: rviz_default_plugins/MarkerArray
      Name: Đường đi đã quét
      Enabled: true
      Topic:
        Value: /slam_toolbox/graph_visualization
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Namespaces:
        slam_toolbox: false
        slam_toolbox_edges: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: Robot Model
      Enabled: false
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/Odometry
      Name: Vị trí xe hiện tại
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Position Tolerance: 0.001
      Angle Tolerance: 0.001
      Keep: 1
      Shape:
        Value: Arrow
        Color: 16; 185; 129
        Alpha: 1
        Shaft Length: 0.35
        Shaft Radius: 0.08
        Head Length: 0.25
        Head Radius: 0.18
      Covariance: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Mapping Top Down
      Scale: 40
Window Geometry:
  Width: 1440
  Height: 900
