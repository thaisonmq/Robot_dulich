POSTGRES_DB=rovera
POSTGRES_USER=rovera
POSTGRES_PASSWORD=rovera-dev-password
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_EMAIL=demo@rovera.local
DEMO_PASSWORD=demo123
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@rovera.local
BOOTSTRAP_ADMIN_NAME=Quản trị hệ thống
FRONTEND_PUBLIC_URL=https://localhost
# Google OAuth (tuỳ chọn). Redirect URI đăng ký tại Google Cloud phải trùng:
# https://CENTER_HOST/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Không giới hạn thời gian xem; giữ phiên 5 phút khi mất mạng để tự kết nối lại.
SESSION_TIMEOUT_SECONDS=0
SESSION_RECONNECT_TIMEOUT_SECONDS=300
# Chỉ bật cho test/demo cũ; robot thực được thêm từ màn Quản lý robot.
SEED_DEMO_ROBOT=false
ROBOT_ID=ROBOT-001
ROBOT_CREDENTIAL=replace-with-a-random-robot-secret-at-least-32-characters
# Hai biến trên chỉ khởi tạo ROBOT-001 cho lần chạy đầu. Robot mới được thêm
# bằng IP/tài khoản/mật khẩu trong màn Danh sách robot; Center lưu PBKDF2 hash
# và edge tự claim khi chạy, không cần thêm từng robot vào .env của Center.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-at-least-32-characters-long
MAP_BUNDLE_MAX_BYTES=536870912
MAP_BUNDLE_MAX_UNCOMPRESSED_BYTES=1073741824
MAP_BUNDLE_MAX_MEMBER_BYTES=805306368
MAP_BUNDLE_MAX_MEMBERS=64
MAP_BUNDLE_MAX_COMPRESSION_RATIO=2000
MAP_BUNDLE_MAX_IMAGE_PIXELS=100000000
LIVEKIT_PUBLIC_URL=wss://localhost
# Máy khác/LAN: LIVEKIT_PUBLIC_URL=wss://CENTER_LAN_IP
# URL LiveKit riêng cho robot; để trống nếu giống LIVEKIT_PUBLIC_URL.
# LIVEKIT_ROBOT_URL=wss://CENTER_LAN_IP
SIMULATOR_MEDIA_SOURCE_TYPE=rtsp
SIMULATOR_MEDIA_SOURCE=rtsp://user:password@CAMERA_IP:554/live
SIMULATOR_AUDIO_SOURCE=
MEDIA_ENABLED=true
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=20
VIDEO_BITRATE=2500000
# H.264 hợp lệ sẽ passthrough; chỉ nguồn có cadence/timestamp lỗi mới encode lại.
RTSP_NORMALIZE=false
RTSP_AUTO_NORMALIZE=true
# Optional when SIMULATOR_MEDIA_SOURCE only contains rtsp://user:pass@host:port
SIMULATOR_RTSP_PATH=
# Camera USB trên máy simulator/Orange Pi:
# SIMULATOR_MEDIA_SOURCE_TYPE=camera
# SIMULATOR_MEDIA_SOURCE=/dev/video0
# SIMULATOR_CAMERA_DEVICE=/dev/video0
# SIMULATOR_CAMERA_FORMAT=mjpeg
# SIMULATOR_CAMERA_WIDTH=1920
# SIMULATOR_CAMERA_HEIGHT=1080
# SIMULATOR_CAMERA_FPS=25
# Optional host-port overrides:
# FRONTEND_PORT=8080
# FRONTEND_HTTPS_PORT=443
BACKEND_PORT=8888
# LIVEKIT_HTTP_PORT=7880
# LIVEKIT_TCP_PORT=7881
# LIVEKIT_UDP_START=51000
# LIVEKIT_UDP_END=51020
# IP LAN của máy chạy LiveKit, dùng cho ICE khi LiveKit chạy trong Docker.
# LIVEKIT_NODE_IP=192.168.1.10
# Host/IP mà trình duyệt và robot dùng để tới coturn. Hai giá trị IP dưới đây
# phải là IP public hoặc IP LAN có thể truy cập từ client.
# TURN_HOST=192.168.1.10
# TURN_EXTERNAL_IP=192.168.1.10
# TURN_REALM=rovera.local
TURN_SECRET=replace-with-a-random-turn-secret-at-least-32-characters
# TURN_PORT=3478
# TURN_UDP_START=49160
# TURN_UDP_END=49200
# Nginx tự tạo CA nội bộ và chứng thư server trong src/infrastructure/tls.
# Đặt hostname/IP đúng trước lần chạy đầu hoặc thay server.crt/server.key bằng
# chứng thư CA tin cậy. Trình duyệt/robot phải tin ca.crt nếu dùng CA nội bộ.
# TLS_HOSTNAME=192.168.1.10
# Local run.sh overrides:
# CENTER_BACKEND_HOST=0.0.0.0
CENTER_BACKEND_PORT=8888
# Khi simulator chạy trên máy khác:
# CENTER_API_URL=https://CENTER_HOST
# CENTER_ROBOT_WS_URL=wss://CENTER_HOST/ws/robot/connect
# CENTER_TLS_VERIFY=true
# CENTER_TLS_CA_FILE=/etc/rovera/ca.crt
# CENTER_FRONTEND_HOST=0.0.0.0
# CENTER_FRONTEND_PORT=5173
