<?xml version="1.0"?>
<robot name="rovera_pi5">
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><geometry><box size="0.30 0.20 0.15"/></geometry></visual>
    <collision><geometry><box size="0.30 0.20 0.15"/></geometry></collision>
  </link>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>
  <link name="laser_frame"/>
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/><child link="laser_frame"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>
  <link name="imu_frame"/>
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/><child link="imu_frame"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
</robot>
