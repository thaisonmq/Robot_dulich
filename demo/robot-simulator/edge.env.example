# Chạy thủ công: copy file này thành .env cạnh run.sh và chmod 600.
# Chạy systemd: copy tới /etc/rovera/robot.env.
CENTER_API_URL=https://center.example.com
CENTER_ROBOT_WS_URL=wss://center.example.com/ws/robot/connect
CENTER_TLS_VERIFY=true
# CENTER_TLS_CA_FILE=/etc/rovera/center-ca.crt

# Tài khoản cố định được tạo sẵn trên image/robot. Operator chỉ nhập ba giá trị
# địa chỉ, tài khoản, mật khẩu này trong màn Thêm robot của Center.
ROBOT_MANAGEMENT_ADDRESS=192.168.1.20
ROBOT_USERNAME=operator
ROBOT_PASSWORD=replace-with-robot-local-password
# Chạy thủ công bằng user hiện tại:
ROBOT_STATE_FILE=~/.config/rovera/device.json
# Với systemd rovera-robot.service:
# ROBOT_STATE_FILE=/var/lib/rovera/device.json

# Docker Compose mặc định dùng ./state cạnh compose.yaml, không phụ thuộc $HOME
# và hoạt động giống nhau khi chạy bằng docker hoặc sudo docker. Chỉ đặt biến
# này nếu muốn lưu ở thư mục tuyệt đối khác:
# ROBOT_STATE_DIR=/data/rovera
# Chạy bằng user đầu tiên trên Ubuntu thường là 1000:1000.
ROBOT_UID=1000
ROBOT_GID=1000
# Kiểm tra bằng: getent group video; getent group audio
VIDEO_GID=44
AUDIO_GID=29
# Socket PipeWire/PulseAudio của user chạy desktop. Mặc định phù hợp Ubuntu
# user đầu tiên (UID 1000); đổi nếu robot chạy desktop bằng UID khác.
# PULSE_SOCKET_DIR=/run/user/1000/pulse
# Kiểm tra bằng: getent group render
RENDER_GID=110

# Tuỳ chọn nâng cao cho robot ở môi trường không dùng credential claim:
# ROBOT_ENROLLMENT_TOKEN=paste-one-time-token-from-center

# Không cần khai báo camera/microphone tại đây. Robot khởi động bằng nguồn kiểm
# thử an toàn; sau khi online, chọn USB camera, RTSP và microphone trong màn
# Cấu hình robot trên Center. Cấu hình sẽ được lưu vào ROBOT_STATE_FILE.

MEDIA_ENABLED=true
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=25
VIDEO_BITRATE=8000000
# Nguồn H.264 được chuyển thẳng sang LiveKit, không giải mã/mã hoá lại.
# Nguồn raw/MJPEG mới cần encoder bên dưới.
# auto | software | hardware | vaapi | nvenc | rkmpp | v4l2m2m
VIDEO_ENCODER=auto
# auto: dùng encoded publisher cho camera/RTSP/file, raw SDK cho test pattern.
# encoded: bắt buộc pipeline tối ưu; raw: pipeline tương thích cũ.
VIDEO_PIPELINE=auto
VIDEO_PASSTHROUGH=true
# Image ARM64/RK3588 tự phát hiện binary có MPP; thông thường giữ nguyên.
VIDEO_FFMPEG_BINARY=ffmpeg
