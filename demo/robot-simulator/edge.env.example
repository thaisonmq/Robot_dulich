# Chạy thủ công: copy file này thành .env cạnh run.sh và chmod 600.
# Chạy systemd: copy tới /etc/rovera/robot.env.
CENTER_API_URL=https://center.example.com
CENTER_ROBOT_WS_URL=wss://center.example.com/ws/robot/connect
CENTER_TLS_VERIFY=true
# Khi chạy bằng compose.yaml và đặt ca.crt cạnh file .env:
# CENTER_TLS_CA_HOST_FILE=./ca.crt
# CENTER_TLS_CA_FILE=/etc/rovera/rovera-ca.crt
# Với CA nội bộ/tự ký, file trên cũng được runtime dùng để xác minh WSS LiveKit.

# Tài khoản cố định được tạo sẵn trên image/robot. Operator chỉ nhập ba giá trị
# địa chỉ, tài khoản, mật khẩu này trong màn Thêm robot của Center.
ROBOT_MANAGEMENT_ADDRESS=192.168.1.20
ROBOT_USERNAME=operator
ROBOT_PASSWORD=replace-with-robot-local-password
# Chạy thủ công bằng user hiện tại:
ROBOT_STATE_FILE=~/.config/rovera/device.json
# Với systemd rovera-robot.service:
# ROBOT_STATE_FILE=/var/lib/rovera/device.json

# Docker Compose mặc định dùng ./state cạnh compose.yaml, không phụ thuộc $HOME
# và hoạt động giống nhau khi chạy bằng docker hoặc sudo docker. Chỉ đặt biến
# này nếu muốn lưu ở thư mục tuyệt đối khác:
# ROBOT_STATE_DIR=/data/rovera
# Chạy bằng user đầu tiên trên Ubuntu thường là 1000:1000.
ROBOT_UID=1000
ROBOT_GID=1000
# Kiểm tra bằng: getent group video; getent group audio
VIDEO_GID=44
AUDIO_GID=29
# Socket PipeWire/PulseAudio của user chạy desktop. Mặc định phù hợp Ubuntu
# user đầu tiên (UID 1000); đổi nếu robot chạy desktop bằng UID khác.
# PULSE_SOCKET_DIR=/run/user/1000/pulse
# Kiểm tra bằng: getent group render
RENDER_GID=110

# Điều khiển xe thật là opt-in. Trên Pi có stack vendor, không sửa trực tiếp
# các dòng dưới rồi chạy Compose. Dùng scripts/start_pi_coexistence.sh hoặc
# scripts/cutover_managed_motion.sh để preflight và ép routing an toàn.
# `disabled` giữ camera/real mapping nhưng reject Web motion; `ros2` chỉ dùng
# sau managed-motion cutover. `simulator` dành cho robot mô phỏng.
MOTION_BACKEND=simulator
NAVIGATION_BACKEND=simulator
MOTION_WATCHDOG_MS=250
# A stop is only acknowledged after fresh odometry remains inside these
# measured-zero limits for the complete dwell window.
STOP_CONFIRMATION_TIMEOUT_SECONDS=3.0
STOP_ZERO_DWELL_SECONDS=0.25
STOP_LINEAR_THRESHOLD=0.015
STOP_ANGULAR_THRESHOLD=0.03
ROS_DOMAIN_ID=20
# Reuse the existing Yahboom EKF/robot_state_publisher when running on the
# legacy hardware image. This prevents duplicate TF authorities during Nav2.
ROVERA_USE_VENDOR_BASE_RUNTIME=1
NAVIGATION_MODE_SWITCH_TIMEOUT_SECONDS=60
# Giới hạn bundle map phải đồng bộ với Center. Edge kiểm cả file nén, tổng byte
# giải nén, từng member, số member, compression ratio và số pixel ảnh.
MAP_BUNDLE_MAX_BYTES=536870912
MAP_BUNDLE_MAX_UNCOMPRESSED_BYTES=1073741824
MAP_BUNDLE_MAX_MEMBER_BYTES=805306368
MAP_BUNDLE_MAX_MEMBERS=64
MAP_BUNDLE_MAX_COMPRESSION_RATIO=2000
MAP_BUNDLE_MAX_IMAGE_PIXELS=100000000
MICRO_ROS_AGENT_VERBOSITY=4
ROS_WEB_CMD_VEL_TOPIC=/cmd_vel_web
ROS_COMMAND_RATE_HZ=30
ROS_MAX_FORWARD_SPEED=0.33
ROS_MAX_REVERSE_SPEED=0.25
ROS_MAX_ANGULAR_SPEED=0.8
# Giới hạn trên cho Web manual khi SLAM đang MAPPING. Người vận hành chọn
# Chậm/Vừa/Nhanh trên Web; không nên dùng Nhanh khi scan matching kém ổn định.
MAPPING_MAX_FORWARD_SPEED=0.18
MAPPING_MAX_REVERSE_SPEED=0.14
MAPPING_MAX_ANGULAR_SPEED=0.40
# Chế độ song song giữ nguyên Yahboom/micro-ROS đang chạy. Bridge chỉ phát
# /cmd_vel_web khi joystick vật lý /joy không hoạt động; motion-safety là
# producer duy nhất của /cmd_vel cuối.
ROS_USE_TWIST_MUX=false
ROS_LEGACY_JOY_TOPIC=/joy
ROS_LEGACY_JOY_STATE_TOPIC=/JoyState
ROS_LEGACY_JOY_DEADZONE=0.12
ROS_LEGACY_JOY_AXES=1,2
ROS_LEGACY_OVERRIDE_MS=350
# Chương trình chống vật cản publish std_msgs/Bool lên /rovera/obstacle_stop.
# Khóa theo hướng publish std_msgs/UInt8 lên /rovera/obstacle_directions:
# bit 0=trước, bit 1=sau, bit 2=trái, bit 3=phải.
# Production yêu cầu heartbeat 500 ms: khởi động/mất tín hiệu cảm biến đều
# khóa xe cho tới khi nhận trạng thái mới. Chỉ đặt 0 trong bench/service mode
# khi nguồn obstacle ngoài chủ ý không được lắp và motion output đã bị cô lập.
ROS_OBSTACLE_WATCHDOG_MS=500

# Tuỳ chọn nâng cao cho robot ở môi trường không dùng credential claim:
# ROBOT_ENROLLMENT_TOKEN=paste-one-time-token-from-center

# Không cần khai báo camera/microphone/loa tại đây. Robot khởi động bằng nguồn
# kiểm thử an toàn; sau khi online, chọn USB camera, RTSP, microphone và loa
# trong màn Cấu hình robot trên Center. Cấu hình được lưu vào ROBOT_STATE_FILE.
# Camera USB mặc định quét mode V4L2 thực tế và tự chọn theo VIDEO_* bên dưới.
# Chỉ bỏ comment các dòng này khi cần ép một mode đã xác nhận là có hỗ trợ:
# SIMULATOR_CAMERA_FORMAT=
# SIMULATOR_CAMERA_WIDTH=0
# SIMULATOR_CAMERA_HEIGHT=0
# SIMULATOR_CAMERA_FPS=0
# Với PipeWire/PulseAudio của user khác user chạy service, đặt một trong hai:
# PULSE_UID=1000
# PULSE_SOCKET_DIR=/run/user/1000/pulse

MEDIA_ENABLED=true
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=20
# 2.5 Mbps là fallback môi trường; profile Balanced từ Center dùng 2.0 Mbps
# để giữ airtime điều khiển trên Wi-Fi 2.4 GHz. 1080p chỉ nên dùng passthrough.
VIDEO_BITRATE=2500000
# Nguồn H.264 được chuyển thẳng sang LiveKit, không giải mã/mã hoá lại.
# Nguồn raw/MJPEG mới cần encoder bên dưới.
# auto | software | hardware | vaapi | nvenc | rkmpp | v4l2m2m
VIDEO_ENCODER=auto
# auto: dùng encoded publisher cho camera/RTSP/file, raw SDK cho test pattern.
# encoded: bắt buộc pipeline tối ưu; raw: pipeline tương thích cũ.
VIDEO_PIPELINE=auto
VIDEO_PASSTHROUGH=true
# Tự giữ H.264 chuẩn ở đường copy và sửa cadence cho RTSP lỗi timestamp.
RTSP_NORMALIZE=false
RTSP_AUTO_NORMALIZE=true
# generic cho Raspberry Pi 5; chỉ đặt rk3588 trên board Rockchip tương ứng.
MEDIA_PLATFORM=generic
VIDEO_FFMPEG_BINARY=ffmpeg
