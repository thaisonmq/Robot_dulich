+func (t *publisherTrack) paceVideo() {
+	if t.frameDuration <= 0 {
+		return
+	}
+	now := time.Now()
+	if t.nextWriteAt.IsZero() || now.Sub(t.nextWriteAt) > 3*t.frameDuration {
+		t.nextWriteAt = now
+	}
+	if wait := time.Until(t.nextWriteAt); wait > 0 {
+		time.Sleep(wait)
+	}
+	t.nextWriteAt = t.nextWriteAt.Add(t.frameDuration)
+}
+
+func (t *publisherTrack) sampleDuration(s *gst.Sample, buffer *gst.Buffer) time.Duration {
+	if t.frameDuration > 0 {
+		t.rememberTimestamp(buffer)
+		return t.frameDuration
+	}
+
+	if duration := buffer.Duration().AsDuration(); duration != nil && *duration > 0 {
+		t.rememberTimestamp(buffer)
+		return *duration
+	}
+
+	timestamp := buffer.PresentationTimestamp()
+	if timestamp == gst.ClockTimeNone {
+		timestamp = buffer.DecodingTimestamp()
+	}
+	if timestamp != gst.ClockTimeNone {
+		if t.lastTimestamp != gst.ClockTimeNone && timestamp > t.lastTimestamp {
+			duration := time.Duration(timestamp - t.lastTimestamp)
+			t.lastTimestamp = timestamp
+			if duration >= time.Millisecond && duration <= time.Second {
+				return duration
+			}
+		} else {
+			t.lastTimestamp = timestamp
+		}
+	}
+
+	if caps := s.GetCaps(); caps != nil && caps.GetSize() > 0 {
+		if value, err := caps.GetStructureAt(0).GetValue("framerate"); err == nil {
+			if framerate, ok := value.(*gst.FractionValue); ok {
+				if framerate.Num() > 0 && framerate.Denom() > 0 {
+					return time.Second * time.Duration(framerate.Denom()) /
+						time.Duration(framerate.Num())
+				}
+			}
+		}
+	}
+
+	return time.Second / 30
+}
+
+func (t *publisherTrack) rememberTimestamp(buffer *gst.Buffer) {
+	t.lastTimestamp = buffer.PresentationTimestamp()
+	if t.lastTimestamp == gst.ClockTimeNone {
+		t.lastTimestamp = buffer.DecodingTimestamp()
+	}
+}
