ROS_DOMAIN_ID=20
REQUIRE_SENSOR_HEALTH=1
NAVIGATION_DEBUG_LOG=true
# File is stored under ROBOT_STATE_DIR through the existing /var/lib/rovera bind.
NAVIGATION_DEBUG_LOG_PATH=/var/lib/rovera/navigation/logs/navigation-debug.log
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROBOT_ID=ROBOT-001
ROBOT_STATE_DIR=./state
# MAPPING hoặc NAVIGATION; đổi mode bằng cách recreate riêng navigation-stack.
NAVIGATION_MODE=NAVIGATION
MAPPING_PREVIEW_MAX_CELLS=20000
# Chỉ dùng khi muốn boot thẳng một map cache đã verify.
NAV2_MAP_YAML=/opt/rovera/config/bootstrap-map.yaml
