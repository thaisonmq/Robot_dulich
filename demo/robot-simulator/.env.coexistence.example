# Overlay an existing private .env when using compose.coexistence.yml.
# Do not put credentials in this example file.
ROS_DOMAIN_ID=20
ROVERA_USE_VENDOR_BASE_RUNTIME=1
NAVIGATION_MODE_SWITCH_TIMEOUT_SECONDS=60
ROBOT_UID=1000
ROBOT_GID=1000
ROBOT_STATE_DIR=./state

# These values are forced by compose.coexistence.yml and are repeated only to
# make the operating contract visible: Web motion is rejected, real SLAM is
# enabled and the vendor joystick remains the only manual motion source.
MOTION_BACKEND=disabled
NAVIGATION_BACKEND=ros2
